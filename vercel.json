{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "experimentalServices": {
    "web": {
      "entrypoint": "apps/web",
      "routePrefix": "/",
      "framework": "vite"
    },
    "api": {
      "entrypoint": "apps/api/main.py",
      "routePrefix": "/api",
      "includeFiles": "app/domain/saju/data/**",
      "memory": 1024,
      "maxDuration": 60
    }
  }
}
