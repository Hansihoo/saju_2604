# Copy this file to apps/api/.env.local and fill in your real values.

OPENAI_API_KEY=DEFINE_OPENAI_API_KEY
OPENAI_MODEL=gpt-5.4-mini
SAJU_LLM_PROVIDER=openai
SAJU_LLM_REASONING_EFFORT=low
SAJU_LLM_MAX_OUTPUT_TOKENS=12000
SAJU_LLM_STORE=0
SAJU_LLM_MAX_ATTEMPTS=2
SAJU_LLM_TIMEOUT_SECONDS=90
SAJU_LLM_ALLOW_REPAIR=1
# Leave request logging disabled unless diagnosing a local issue.
SAJU_REQUEST_LOG_ENABLED=0
SAJU_REQUEST_LOG_INCLUDE_INPUT=0
SAJU_DETAIL_CACHE_TTL_SECONDS=900
SAJU_DETAIL_CACHE_MAX_ENTRIES=128
# Optional: enables debug_trace only when the same token is sent in X-Saju-Internal-Debug-Token.
SAJU_INTERNAL_DEBUG_TOKEN=
# Keep the established lunar_python year/month calculation as the primary production rule.
SAJU_USE_CANONICAL_YEAR_MONTH_PILLARS=0
