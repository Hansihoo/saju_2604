  "description": "Hard reference cases for timezone normalization and DST behavior using Python zoneinfo/IANA tzdb as the external reference.",
  "cases": [
    {
      "case_id": "zoneinfo_asia_seoul_regular_1994",
      "description": "Regular Asia/Seoul local time without DST.",
      "input": {
        "operation": "normalize_birth_datetime",
        "birth_date": "1994-10-13",
        "birth_time": "08:30",
        "tzid": "Asia/Seoul"
      },
      "expected": {
        "normalized_local_datetime": "1994-10-13T08:30:00+09:00",
        "normalized_utc_datetime": "1994-10-12T23:30:00+00:00",
        "offset_minutes": 540,
        "ambiguous": false,
        "fold": 0,
        "daylight_saving_offset_minutes": 0
      },
      "source": {
        "type": "external_reference",
        "name": "Python zoneinfo with IANA tzdb",
        "url": "https://www.iana.org/time-zones",
        "retrieved_at": "2026-05-16"
      },
      "tolerance": {
        "seconds": 0
      },
      "notes": "Baseline Korean standard-time reference."
    },
